# Copy to .env (or let the installer create /etc/pz-control/pz-control.env).

# Admin login password (required, 12+ characters).
PZ_ADMIN_PASSWORD=change-this-before-starting

# Bind to the VPN/LAN interface address if possible, not 0.0.0.0.
HOST=127.0.0.1
PORT=8080

# Where panel state lives (2FA secret and backup-code hashes in 2fa.json).
PZ_DATA_DIR=./data

# Project Zomboid server files
PZ_SERVER_DIR=/home/pzuser/Zomboid/Server
PZ_INI_FILE=servertest.ini
PZ_SANDBOX_FILE=servertest_SandboxVars.lua
PZ_SPAWN_REGIONS_FILE=servertest_spawnregions.lua
PZ_SPAWN_POINTS_FILE=servertest_spawnpoints.lua
PZ_SERVICE=project-zomboid

# RCON of the local Project Zomboid server. The password never leaves this machine.
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=

# Set to "sudo" only after adding the narrow sudoers rule (the installer does this).
SYSTEMCTL_PREFIX=
